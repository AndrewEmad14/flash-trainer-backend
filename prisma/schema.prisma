// Data model for 001-user-auth. Canonical source: specs/001-user-auth/data-model.md
// Conventions (constitution §V): snake_case tables (plural) and columns via @@map/@map,
// UUID ids, timestamptz everywhere.

generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

/// A person using the app. data-model.md: User
model User {
  id              String    @id @default(uuid()) @db.Uuid
  fullName        String    @map("full_name") @db.VarChar(100)
  /// Case-insensitive unique (citext). The 3–30 length is enforced by the DTO + a CHECK in the migration.
  username        String    @unique @db.Citext
  /// Always stored trimmed and lowercased.
  email           String    @unique @db.VarChar(254)
  emailVerifiedAt DateTime? @map("email_verified_at") @db.Timestamptz(3)
  /// E.164. Postgres allows multiple NULLs under UNIQUE.
  phone           String?   @unique @db.VarChar(16)
  /// argon2id. Nullable at DB level for future social login; always set for email registration.
  passwordHash    String?   @map("password_hash") @db.VarChar(255)
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  sessions        AuthSession[]
  passwordResets  PasswordReset[]
  emailDispatches EmailDispatch[]

  @@map("users")
}

/// One signed-in device. data-model.md: AuthSession
model AuthSession {
  id               String    @id @default(uuid()) @db.Uuid
  userId           String    @map("user_id") @db.Uuid
  /// SHA-256 hex of the current refresh token (rotated on every refresh).
  refreshTokenHash String    @unique @map("refresh_token_hash") @db.Char(64)
  deviceName       String?   @map("device_name") @db.VarChar(100)
  deviceOs         String?   @map("device_os") @db.VarChar(50)
  fcmToken         String?   @map("fcm_token") @db.VarChar(4096)
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  lastUsedAt       DateTime  @default(now()) @map("last_used_at") @db.Timestamptz(3)
  expiresAt        DateTime  @map("expires_at") @db.Timestamptz(3)
  revokedAt        DateTime? @map("revoked_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([fcmToken])
  @@map("auth_sessions")
}

/// Single-use permission to set a new password. data-model.md: PasswordReset
model PasswordReset {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  tokenHash String    @unique @map("token_hash") @db.Char(64)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  expiresAt DateTime  @map("expires_at") @db.Timestamptz(3)
  usedAt    DateTime? @map("used_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("password_resets")
}

enum EmailDispatchType {
  VERIFY_EMAIL
  RESET_PASSWORD
}

/// Log of auth emails sent, used only for rate limiting. data-model.md: EmailDispatch
model EmailDispatch {
  id        String            @id @default(uuid()) @db.Uuid
  userId    String            @map("user_id") @db.Uuid
  type      EmailDispatchType
  createdAt DateTime          @default(now()) @map("created_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, type, createdAt(sort: Desc)])
  @@map("email_dispatches")
}

/// Sign-in throttle per account or unknown identifier (research R5). No FK by design.
model LoginAttempt {
  throttleKey     String    @id @map("throttle_key") @db.VarChar(300)
  failedCount     Int       @default(0) @map("failed_count")
  windowStartedAt DateTime  @map("window_started_at") @db.Timestamptz(3)
  lockedUntil     DateTime? @map("locked_until") @db.Timestamptz(3)

  @@map("login_attempts")
}
