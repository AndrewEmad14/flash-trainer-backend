# Copy to .env and fill in real values. NEVER commit .env (TruffleHog will block it).

# --- App ---
# development | test | production
NODE_ENV=development
PORT=3000
# fatal | error | warn | info | debug | trace
LOG_LEVEL=info

# --- Database (matches docker-compose.yml) ---
DATABASE_URL=postgresql://flash:flash_dev_password@localhost:5432/flash_trainer
# e2e tests use this instead (created by docker/postgres/init-test-db.sql)
TEST_DATABASE_URL=postgresql://flash:flash_dev_password@localhost:5432/flash_trainer_test

# --- Auth (generate secrets with: openssl rand -base64 48) ---
JWT_ACCESS_SECRET=change-me-to-a-long-random-string
# access token lifetime in seconds (15 min)
JWT_ACCESS_TTL=900
JWT_EMAIL_SECRET=change-me-to-a-different-long-random-string
# sliding session lifetime
REFRESH_TOKEN_TTL_DAYS=30

# --- Links in emails (research R3) ---
# Emulator: http://10.0.2.2:3000/api/v1/links | Phone on same Wi-Fi: http://<your-LAN-IP>:3000/api/v1/links
APP_LINK_BASE_URL=http://10.0.2.2:3000/api/v1/links
APP_DEEP_LINK_SCHEME=flashtrainer

# --- Mail (research R12) ---
# console (logs emails) | smtp
MAIL_DRIVER=console
# Gmail: enable 2-Step Verification, then create an App Password (Google Account > Security > App passwords).
# Use that 16-character App Password as SMTP_PASS, NOT your normal Gmail password.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=your-address@gmail.com
SMTP_PASS=your-16-char-app-password
MAIL_FROM="Flash Trainer <your-address@gmail.com>"

# --- Registration checks (research R18) ---
# Reject emails whose domain can't receive mail (e.g. typos like gmial.con). Off in tests/CI.
EMAIL_DNS_CHECK=true

# --- HTTP ---
# comma-separated allow-list
CORS_ORIGINS=http://localhost:3000
# MUST be false in production (constitution §IV)
SWAGGER_ENABLED=true
